# Copy this file to .env and update the values below

# Application Settings
APP_NAME="Sweet Orders Online"
APP_KEY=
APP_ENV=development
APP_URL=http://localhost:3000

# React app (Vite dev server); comma-separated list of allowed origins for CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Set to 1 only behind a proxy such as Render
TRUST_PROXY=

# Database Configuration (XAMPP MySQL defaults)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sweet_orders
DB_CHARSET=utf8mb4
DB_PREFIX=
